{
  "geode": "5.10.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081"
  },
  "id": "cuuw619.imuxhack",
  "name": "ImuxHack",
  "version": "v0.4.0",
  "developer": "cuuw619-maker",
  "description": "Beat-synced Geometry Dash level generator with FFT analysis, playable preview workflow, validation and soft API integrations.",
  "repository": "https://github.com/cuuw619-maker/ImuxHack",
  "links": {
    "source": "https://github.com/cuuw619-maker/ImuxHack"
  },
  "settings": {
    "audio-file": {
      "name": "Source audio",
      "description": "Optional override audio. Empty means use the song assigned to the current level.",
      "type": "file",
      "default": "",
      "control": {
        "dialog": "open",
        "filters": [
          {
            "description": "MP3/WAV audio",
            "files": [
              "mp3",
              "wav"
            ]
          }
        ]
      }
    },
    "difficulty": {
      "name": "Difficulty",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "control": {
        "slider": true,
        "slider-step": 0.05
      }
    },
    "density": {
      "name": "Object density",
      "type": "float",
      "default": 0.65,
      "min": 0.1,
      "max": 1,
      "control": {
        "slider": true,
        "slider-step": 0.05
      }
    },
    "sync-strength": {
      "name": "Sync strength",
      "type": "float",
      "default": 0.9,
      "min": 0,
      "max": 1,
      "control": {
        "slider": true,
        "slider-step": 0.05
      }
    },
    "movement": {
      "name": "Movement",
      "type": "float",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "control": {
        "slider": true,
        "slider-step": 0.05
      }
    },
    "decoration": {
      "name": "Decoration",
      "type": "float",
      "default": 0.45,
      "min": 0,
      "max": 1,
      "control": {
        "slider": true,
        "slider-step": 0.05
      }
    },
    "beat-sensitivity": {
      "name": "Beat sensitivity",
      "type": "float",
      "default": 0.55,
      "min": 0.1,
      "max": 1,
      "control": {
        "slider": true,
        "slider-step": 0.05
      }
    },
    "seed": {
      "name": "Generator seed",
      "type": "int",
      "default": 1337
    },
    "show-beat-markers": {
      "name": "Show beat markers",
      "type": "bool",
      "default": true
    },
    "show-energy": {
      "name": "Show energy",
      "type": "bool",
      "default": true
    },
    "auto-gamemode": {
      "name": "Automatic gamemode",
      "type": "bool",
      "default": true
    },
    "auto-speed": {
      "name": "Automatic speed",
      "type": "bool",
      "default": true
    }
  }
}
